# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=5s

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=finwise
# SSL Mode: disable (local), require (production), verify-full (production with cert verification)
DB_SSLMODE=disable

# Logger Configuration
# Log Level: debug, info, warn, error
LOG_LEVEL=info
# Log Format: json, text
LOG_FORMAT=json
